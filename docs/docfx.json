{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../sdk/forks.hashgraph.hedera-sdk-reference",
          "files": [
            "**/*.csproj"
          ]
        },
        {
          "src": "../sdk/Hedera.Hashgraph.SDK",
          "files": [
            "**/*.csproj"
          ]
        },
        {
          "src": "../sdk/Hedera.Hashgraph.Tests.SDK",
          "files": [
            "**/*.csproj"
          ]
        },
        {
          "src": "../sdk/Hedera.Hashgraph.Tests.Integration",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Hedera Hashgraph C# SDK Documentation",
      "_appTitle": "Hedera Hashgraph C# SDK Documentation",
      "_enableSearch": true,
      "pdf": true
    }
  }
}